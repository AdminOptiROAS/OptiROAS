{
  "routes": [
    {
      "src": "^/media/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/(?!api/|media/|_vercel|.*\\.)(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.kiteoai.com"
        }
      ],
      "dest": "/kiteo.html"
    },
    {
      "src": "^/(?!api/|media/|_vercel|.*\\.)(.*)$",
      "has": [
        {
          "type": "host",
          "value": "kiteoai.com"
        }
      ],
      "dest": "/kiteo.html"
    },
    {
      "src": "^/ai-visibility/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(privacy|terms|data-deletion|waitlist|welcome|reset|pricing|faq|how|platforms|start|delivered|pillars|calculator|checks|account|guides)$",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/meta/report.js": {
      "maxDuration": 120
    },
    "api/salla/[action].js": {
      "maxDuration": 60
    },
    "api/ai/[action].js": {
      "maxDuration": 300
    },
    "api/health.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/ai/cron",
      "schedule": "25 * * * *"
    }
  ]
}