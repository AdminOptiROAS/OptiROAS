{
  "rewrites": [
    {
      "source": "/(privacy|terms|data-deletion|waitlist|welcome|reset|pricing|faq|how|platforms|start|delivered|pillars|calculator|checks|account)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/meta/report.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "10 4 * * *"
    }
  ]
}