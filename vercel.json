{
  "rewrites": [
    {
      "source": "/(privacy|terms|data-deletion|waitlist|welcome|reset|pricing|faq|how|platforms|start|delivered|pillars|calculator|checks|account|guides)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/meta/report.js": {
      "maxDuration": 120
    },
    "api/salla/[action].js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "10 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}